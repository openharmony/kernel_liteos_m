import("//kernel/liteos_m/liteos.gni")

# gcov dump glue for bare-metal targets (standalone runtime).
#
# The kernel is instrumented with -fprofile-arcs -ftest-coverage
# (kernel/liteos_m/config.gni) but does NOT link libgcov: test_gcov.c
# supplies the gcov runtime symbols the instrumented code references
# (__gcov_init / __gcov_merge_add) and streams the profile over the
# console UART as base64 GCOV_BEGIN/GCOV_END frames. Host-side tooling
# (log parsing, .gcda reconstruction, lcov coverage report) lives in the
# *.py / *.sh files here.

# -fno-stack-protector: the module is intentionally libc-header free, and
# this keeps it free of libc SSP references (__stack_chk_guard /
# __stack_chk_fail) too; applied to the whole debug/test-only module for
# uniformity.
config("gcov_no_ssp") {
  cflags = [ "-fno-stack-protector" ]
}

module_switch = defined(LOSCFG_TEST_KERNEL_COVERAGE)
module_name = "gcov"
kernel_module(module_name) {
  sources = [ "test_gcov.c" ]
  configs += [
    "$LITEOSTOPDIR:warn_config",
    ":gcov_no_ssp",
    # Exclude the gcov runtime itself from instrumentation (it would be
    # circular: the dumper instrumented by gcov trying to dump its own
    # counters). Same single-point exclusion config as the rest of
    # testsuites.
    "//kernel/liteos_m/testsuites:no_test_coverage",
  ]
}

config("public") {
  # test_gcov.h lives in testsuites/include (shared with osTest.c)
  include_dirs = [
    ".",
    "//kernel/liteos_m/testsuites/include",
  ]
}
